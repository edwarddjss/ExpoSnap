{
  "name": "exposnap",
  "version": "3.0.0",
  "description": "Let your AI assistant see and drive your React Native / Expo app on a real phone: screenshots, console logs, navigation. An MCP server for Claude Code, Cursor, VS Code and more.",
  "type": "module",
  "bin": {
    "exposnap": "dist/server/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "dev": "tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server/index.js",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "react-native": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./server": "./dist/server/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwarddjss/ExpoSnap.git"
  },
  "bugs": {
    "url": "https://github.com/edwarddjss/ExpoSnap/issues"
  },
  "homepage": "https://github.com/edwarddjss/ExpoSnap#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "expo",
    "react-native",
    "screenshot",
    "ai",
    "claude",
    "claude-code",
    "cursor",
    "vscode",
    "windsurf",
    "mobile",
    "debugging"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-view-shot": ">=3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-native": "^0.81.4",
    "react-native-view-shot": "^4.0.3",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "author": "Edward De Jesus",
  "types": "dist/client/index.d.ts",
  "main": "dist/client/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "mcpName": "io.github.edwarddjss/exposnap"
}
